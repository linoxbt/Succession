# Succession — every environment variable the project reads.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, and must
# never carry a real key.
#
#   cp .env.example .env
#
# Nothing here is needed to run the offline demo or the test suite. These are
# for the chain, the ACP integration, and a deployed service.

# --- Base Sepolia -----------------------------------------------------------

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deploys ListingContract. Needs ETH for gas.
DEPLOYER_PRIVATE_KEY=

# Holds the ERC-8004 identities and lists them. Needs ETH for gas — it signs
# roughly twenty transactions across a five-transfer run.
SELLER_PRIVATE_KEY=

# Funds escrow and confirms delivery. Needs ETH for gas *and* the payment token.
BUYER_PRIVATE_KEY=

# Optional. Both default to the verified live deployments on Base Sepolia:
#   identity registry  0x7177a6867296406881E20d6647232314736Dd09A  (ERC-8004)
#   payment token      0x036CbD53842c5426634e7929541eC2318f3dCF7e  (Circle USDC)
# Set IDENTITY_REGISTRY_ADDRESS only to point at a different registry. Leaving
# it unset on `--local` uses an ERC-721 stand-in and records
# identity_registry_is_mock: true — never present that as an ERC-8004 transfer.
IDENTITY_REGISTRY_ADDRESS=
PAYMENT_TOKEN_ADDRESS=

# May confirm a delivery alongside the buyer — the Evaluator's role. Defaults to
# the deployer's address.
ARBITER_ADDRESS=

# Contract verification on Basescan.
BASESCAN_API_KEY=

# --- Virtuals ACP -----------------------------------------------------------
#
# Issued by registering the agents in the Virtuals app, not by an SDK call.
# Without ACP_ENTITY_ID the integration is skipped and the valuation falls back
# to its journal heuristic, which is the correct behaviour rather than a
# degraded one.

WHITELISTED_WALLET_PRIVATE_KEY=
AGENT_WALLET_ADDRESS=
ACP_ENTITY_ID=

# --- Service ----------------------------------------------------------------

# Where the demo's SQLite stores live.
SUCCESSION_WORKDIR=demo-state

# Bearer token for every route that changes state. Unset, the service accepts
# writes from localhost only and refuses them from anywhere else — so a deployed
# service without this set cannot be written to at all. Set it to a long random
# value before hosting: `openssl rand -hex 32`.
SUCCESSION_API_TOKEN=

# Comma-separated origins allowed to call the service cross-origin. Defaults to
# the Vite dev server. A deployed frontend has to name itself here, unless it is
# proxied through the same origin (see the /api block in netlify.toml).
SUCCESSION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where to read the deployment record from. Defaults to
# deployments/base-sepolia.json; its presence is the only thing that puts the
# service in on-chain mode.
SUCCESSION_DEPLOYMENT=

# --- Frontend (build time) --------------------------------------------------
#
# Read by Vite, so it must be present when `npm run build` runs, not at runtime.
# If you point this at a non-default RPC host, add that host to the
# Content-Security-Policy connect-src list in netlify.toml or the browser will
# block it silently.
VITE_BASE_SEPOLIA_RPC_URL=
